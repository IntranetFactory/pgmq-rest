{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch src/dev.ts",
    "test": "deno test --allow-net --allow-env src/",
    "deploy": "npx wrangler deploy",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "nodeModulesDir": "auto",
  "lint": {
    "include": ["src/"]
  },
  "fmt": {
    "include": ["src/"],
    "lineWidth": 150,
    "semiColons": true
  }
}
